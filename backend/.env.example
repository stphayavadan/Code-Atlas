# Copy this file to backend/.env and fill in the real values.
# Do not commit backend/.env to source control.

KV_CLIENT_ID=your-azure-client-id
KV_CLIENT_SECRET=your-azure-client-secret
KV_TENANT_ID=your-azure-tenant-id
KV_URL=https://your-keyvault-name.vault.azure.net/

# Optional model overrides:
# CLAUDE_FAST_MODEL=us.anthropic.claude-sonnet-4-6
# CLAUDE_SMART_MODEL=us.anthropic.claude-opus-4-8
